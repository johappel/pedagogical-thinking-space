{
  "$comment": "outputSchema of the semantic capability reviewer subagent (review_capability). Object-rooted, dsh-tools subset. Loaded via capabilities/registry.yml (schema_file).",
  "schema_version": "ptspace.capability-review/v1",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "verdict", "reasons"],
    "properties": {
      "schema": { "type": "string", "const": "ptspace.capability-review/v1" },
      "verdict": { "type": "string", "enum": ["approved", "revision-needed", "rejected"] },
      "reasons": { "type": "array", "items": { "type": "string" } }
    }
  }
}
